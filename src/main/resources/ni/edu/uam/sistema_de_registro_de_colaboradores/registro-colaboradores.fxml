<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="489.0" prefWidth="751.0" spacing="10.0" style="-fx-background-color: #a6a6a6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sistema_de_registro_de_colaboradores.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
   <children>
      <HBox alignment="CENTER" prefHeight="46.0" prefWidth="528.0" spacing="15.0">
         <children>
            <Label text="Sistema de Registro">
               <font>
                  <Font name="Cambria Bold" size="15.0" />
               </font>
            </Label>
            <ImageView fitHeight="41.0" fitWidth="46.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@logo.png" />
               </image></ImageView>
         </children>
      </HBox>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Nuevo">
            <items>
              <MenuItem mnemonicParsing="false" text="Limpiar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Salir">
            <items>
              <MenuItem mnemonicParsing="false" text="Cerrar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Acerca de">
            <items>
              <MenuItem mnemonicParsing="false" text="Ayuda" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <TabPane prefHeight="397.0" prefWidth="528.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Registro">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="TOP_CENTER" prefHeight="364.0" prefWidth="721.0" spacing="10.0" style="-fx-background-color: white;">
                           <children>
                              <ToolBar prefHeight="40.0" prefWidth="200.0">
                                <items>
                                  <Button fx:id="btnSave" mnemonicParsing="false" text="Guardar" />
                                    <Button fx:id="btnClean" mnemonicParsing="false" text="Limpiar" />
                                    <Button fx:id="btnDelete" mnemonicParsing="false" text="Eliminar" />
                                </items>
                              </ToolBar>
                              <HBox alignment="TOP_CENTER" prefHeight="36.0" prefWidth="530.0" spacing="10.0">
                                 <children>
                                    <TextField fx:id="txtName" promptText="Nombres" />
                                    <TextField fx:id="txtSurname" promptText="Apellidos" />
                                    <TextField fx:id="txtUsername" promptText="Usuario" />
                                 </children>
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding></HBox>
                              <HBox alignment="TOP_CENTER" layoutX="15.0" layoutY="65.0" prefHeight="32.0" prefWidth="530.0" spacing="10.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                                 <children>
                                    <PasswordField fx:id="pwfPassword" promptText="Contraseña Inicial" />
                                    <ComboBox fx:id="cbCharge" prefWidth="150.0" promptText="Cargo" />
                                    <DatePicker fx:id="dpContractdate" prefHeight="26.0" prefWidth="150.0" promptText="Fecha de Contratacion" />
                                 </children>
                              </HBox>
                              <HBox alignment="TOP_CENTER" layoutX="15.0" layoutY="112.0" prefHeight="131.0" prefWidth="530.0" spacing="10.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                                 <children>
                                    <VBox alignment="TOP_CENTER" prefHeight="109.0" prefWidth="212.0">
                                       <children>
                                          <Label text="Area de trabajo:">
                                             <font>
                                                <Font name="System Bold Italic" size="12.0" />
                                             </font>
                                          </Label>
                                          <ListView fx:id="lstvContracttype" prefHeight="84.0" prefWidth="138.0" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0">
                                       <children>
                                          <Label text="Tipo de Contrato:">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                          <RadioButton fx:id="rbtnNormalcontract" mnemonicParsing="false" prefHeight="18.0" prefWidth="75.0" text="Normal">
                                             <toggleGroup>
                                                <ToggleGroup fx:id="tgContracttype" />
                                             </toggleGroup>
                                          </RadioButton>
                                          <RadioButton fx:id="rbtnAnnormalcontract" mnemonicParsing="false" text="Quebrado" toggleGroup="$tgContracttype" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="TOP_CENTER" layoutX="15.0" layoutY="112.0" prefHeight="34.0" prefWidth="530.0" spacing="10.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                                 <children>
                                    <VBox alignment="TOP_RIGHT" prefHeight="13.0" prefWidth="100.0">
                                       <children>
                                          <Label text="Beneficios:">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <CheckBox fx:id="chbxVacations" mnemonicParsing="false" text="Vacaciones" />
                                    <CheckBox fx:id="chxbSaturdaysoff" mnemonicParsing="false" text="Sabados libres" />
                                    <CheckBox fx:id="chxbExit6pm" mnemonicParsing="false" text="Salida 6:00 PM" />
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Visualizacion">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox prefHeight="343.0" prefWidth="721.0" style="-fx-background-color: white;">
                           <children>
                              <TableView fx:id="tvUsers" prefHeight="342.0" prefWidth="590.0">
                                <columns>
                                  <TableColumn fx:id="colFullname" prefWidth="75.0" text="Nombre" />
                                  <TableColumn fx:id="colCharge" prefWidth="75.0" text="Cargo" />
                                    <TableColumn fx:id="colArea" prefWidth="75.0" text="Area" />
                                    <TableColumn fx:id="colContractdate" prefWidth="75.0" text="Fecha contratacion" />
                                    <TableColumn fx:id="colContracttype" prefWidth="75.0" text="Tipo Contrato" />
                                    <TableColumn fx:id="colBenefits" prefWidth="75.0" text="Beneficios" />
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </children></AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>
